# ─────────────────────────────────────────────────────────────
#  KrishiMitra AI – Environment Variables
#  Copy this file to .env and fill in your IBM Cloud credentials
# ─────────────────────────────────────────────────────────────

# IBM Cloud IAM API Key (from cloud.ibm.com → Manage → Access → API Keys)
WATSONX_API_KEY=API_KEY_HERE
# watsonx.ai Project ID (from dataplatform.cloud.ibm.com → Your Project → Manage → General)
WATSONX_PROJECT_ID=PROJECT_ID_HERE

# watsonx.ai Regional Endpoint
WATSONX_URL=https://au-syd.ml.cloud.ibm.com

# IBM Granite model identifier
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# Local development port
PORT=3000
